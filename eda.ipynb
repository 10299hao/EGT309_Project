    "# -- Non-linear/ANOVA-style effect size for each numerical feature ---------------------\n",
    "def eta_squared(feature, target=\"Activity Level\"):\n",
    "    overall_mean = df_clean[feature].mean()\n",
    "    groups = [g[feature].dropna() for _, g in df_clean.groupby(target)]\n",
    "    ss_between = sum(len(g) * (g.mean() - overall_mean) ** 2 for g in groups)\n",
    "    ss_total = ((df_clean[feature] - overall_mean) ** 2).sum()\n",
    "    return ss_between / ss_total if ss_total else np.nan\n",
    "\n",
    "effect_sizes = pd.Series({col: eta_squared(col) for col in sensor_cols}, name=\"eta_squared\")\n",
    "effect_sizes.sort_values(ascending=False).to_frame().round(4)"
